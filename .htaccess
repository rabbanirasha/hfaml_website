<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(json|lock)$">
    Require all denied
</FilesMatch>

RewriteRule ^(vendor|storage|bootstrap|config|database|resources|tests|routes|app)/ - [F,L]
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real static files directly (build assets, docs, img, etc.)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else goes through Laravel's front controller
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
