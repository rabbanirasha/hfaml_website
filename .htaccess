<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(json|lock)$">
    Require all denied
</FilesMatch>

RewriteRule ^(vendor|storage|bootstrap|config|database|resources|tests|routes|app)/ - [F,L]
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all requests to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
